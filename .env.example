# Gemini Settings (Primary LLM)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Groq Settings (Fallback LLM)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# System Configuration
USE_MOCK_TOOLS=1
USE_CACHE=1
FORCE_FALLBACK=0
# Frontend: 1 forces canned demo data, 0 uses the real pipeline.
# When unset and no LLM key is present, the UI falls back to demo data automatically.
USE_STUB_UI=0

# Entity Checker reputation providers (optional).
# Without a key the provider is reported as "not checked" (null) rather than
# as safe. Local URL parsing, WHOIS, phone, UPI and sender checks always run.
# VirusTotal v3 - https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=
# Google Safe Browsing v4 - https://developers.google.com/safe-browsing/v4/get-started
SAFE_BROWSING_API_KEY=
# URLhaus abuse.ch Auth-Key (required by the URLhaus API)
URLHAUS_AUTH_KEY=
