# Scam Shield v2 Configuration Template
# Copy to root .env or v2/.env for local v2 development. Never commit real keys.

# LLM Providers (Inherited from root or configured here)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
FORCE_FALLBACK=0
USE_MOCK_TOOLS=1
USE_CACHE=1

# Backend API Settings
APP_ENV=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_ANALYZE=10/minute
RATE_LIMIT_DEFAULT=60/minute
MAX_IMAGE_MB=5
MAX_TEXT_CHARS=5000
PIPELINE_TIMEOUT_S=25.0
STAGE_TIMEOUT_S=15.0

# Community Database (Optional)
COMMUNITY_ENABLED=false
COMMUNITY_ESCALATION=false
DATABASE_URL=sqlite:///./scam_shield_v2.db
HASH_SALT=scam_shield_salt_change_in_production

# Frontend Settings (Next.js)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_USE_MOCK=0
